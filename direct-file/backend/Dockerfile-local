#syntax=docker/dockerfile:1.7-labs
# Note: This uses some relatively new features, so make sure docker is
#       up-to-date on your system or this build may fail

# 0. the client's generated fact-dictionary files (gitignored, so not in a fresh checkout)
# SubmissionBlockingFactsTest compares them with the server's submission-blocking facts.
# Generate them with `npm ci && npm run generate-fact-dictionary` in df-client/df-client-app,
# then pass the directory with
# `--build-context client-generated=../df-client/df-client-app/src/fact-dictionary/generated`
# (docker_build.sh and docker-compose.yaml do this). Without that context this stage, which
# holds only a marker file, is used, and a build that runs the tests stops before Maven runs.
# The stage is not left empty: BuildKit can reuse a cached COPY from an empty scratch stage
# for a COPY from a real context, which would skip the check below.
FROM scratch AS client-generated
COPY <<EOF /client-generated-context-missing
No client-generated build context was passed to this build.
EOF

# 1. build factgraph
# For this step to work, you must define `factgraph-repo` in either your
# docker-compose.yaml's `additional_contexts` or from the command line with
# `docker buildx build --build-context factgraph-repo=/some/path [other args]`
FROM sbtscala/scala-sbt:eclipse-temurin-alpine-21.0.2_13_1.9.9_3.3.3@sha256:3e8a36e9286f48cdaa4aa7b2c347321ae7271144ea3cadf718e6c6c905c10361 AS factgraph-builder
WORKDIR /build/
COPY --from=factgraph-repo js/src/ js/src/
COPY --from=factgraph-repo jvm/src/ jvm/src/
COPY --from=factgraph-repo project/build.properties project/plugins.sbt project/
COPY --from=factgraph-repo shared/ shared/
COPY --from=factgraph-repo build.sbt .
RUN sbt compile package publishM2

# 2. build shared dependencies
FROM eclipse-temurin:21-jdk-alpine@sha256:0bfc69a4758a86710e5c474032d28400a8bd00874766f9e8b1642ac2fd293159 AS shared-dependencies-builder
COPY --from=factgraph-builder /root/.m2/repository/gov/irs/factgraph/fact-graph_3/ /root/.m2/repository/gov/irs/factgraph/fact-graph_3/
ARG MAVEN_OPTS=""
WORKDIR /build/
COPY --from=config . ./config/
COPY --from=boms . ./boms/
WORKDIR /build/libs/
COPY --from=shared-libs .mvn/wrapper/maven-wrapper.properties .mvn/wrapper/
COPY --from=shared-libs mvnw ./
COPY --from=shared-libs --parents **/pom.xml ./
RUN ./mvnw dependency:resolve -P resolve
COPY --from=shared-libs starters/ ./starters/
COPY --from=shared-libs data-models/ ./data-models/
RUN ./mvnw install

# 5. build backend spring api
FROM shared-dependencies-builder AS api-builder
ARG MAVEN_OPTS=""
ENV MEF_REPO /mef-repo
COPY --from=config . /config/
WORKDIR /build/
COPY mvnw ./
COPY .mvn/wrapper/maven-wrapper.properties .mvn/wrapper/
COPY pom.xml ./
RUN ./mvnw dependency:resolve
# copy source tree after dependency resolution so source changes don't force re-download of all dependencies
COPY src/ /build/src/
# The tests read the client's generated list at ../df-client/... relative to /build/.
COPY --from=client-generated . /df-client/df-client-app/src/fact-dictionary/generated/
# SKIP_CHECKS=true (set only by docker-compose.local.yaml) builds the jar
# without running tests or the spotless check; every other build runs both,
# including the client-generated parity test, and fails if the list is missing.
ARG SKIP_CHECKS=false
RUN if [ "$SKIP_CHECKS" = "true" ]; then \
      ./mvnw package -DskipTests -Dspotless.check.skip=true; \
    elif [ ! -f /df-client/df-client-app/src/fact-dictionary/generated/submissionBlockingFacts.ts ]; then \
      echo "client-generated build context is missing submissionBlockingFacts.ts:" \
        "run 'npm ci && npm run generate-fact-dictionary' in df-client/df-client-app and pass" \
        "--build-context client-generated=../df-client/df-client-app/src/fact-dictionary/generated" >&2; \
      exit 1; \
    else \
      ./mvnw package; \
    fi

# 6. bundle backend api jar into runnable image
FROM eclipse-temurin:21-jre-alpine@sha256:51ab5e3302e7141ce665ca3ea85e8b5cd648eafbc3c0c90dd79d6537684e4555
ENV SPRING_PROFILES_ACTIVE=development
COPY --from=api-builder /build/target/directfile-api-0.0.1-SNAPSHOT.jar /app.jar
RUN adduser --system --no-create-home jar-runner
USER jar-runner
CMD ["java", "-jar", "/app.jar"]
