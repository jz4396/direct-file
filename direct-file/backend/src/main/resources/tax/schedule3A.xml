<?xml-model href="./FactDictionaryModule.rng"?>
<!--
  Schedule 3-A (Form 1040), Federal Public Benefit — TY2026.

  2026 draft Schedule 3-A (early-release draft, "Created 6/24/26"), irs.gov/pub/irs-dft.
  The draft file name contains a double hyphen, which an XML comment cannot hold; the URL is in
  /pdfIncludeSchedule3A. SHA-256
  787e1ae1eaa3e23a184074d0f437f6b2a8fe3f01290f366201f14eeecc82b8db.
  No Schedule 3-A instructions are posted yet; every line below follows the draft form.

  Complete the schedule only when claiming the earned income credit (26 U.S.C. 32), the additional
  child tax credit (26 U.S.C. 24(d)), the refundable American opportunity credit (26 U.S.C. 25A(i)),
  or the refundable adoption credit (26 U.S.C. 23). 2026 draft Form 1040, form page 2 (PDF p. 3),
  line 32 margin: "If you entered an amount on line 27a, 28, 29, or 30, attach Sch. 3-A."
  Line 32b is the "Amount from Schedule 3-A." Line 32c subtracts line 32b from line 32a.
  Line 33 adds lines 25d, 26, and 32c.

  Line 30 (refundable adoption credit, Form 8839) is not computed, so it stays off line 2.
  Form 1040-NR and Form 1040-SS special rules on lines 1a, 1b, 2, 3, 4, 6, 7 and 8 are out of
  scope: this tool files Form 1040.
-->
<FactDictionaryModule>
  <Facts>
    <Fact path="/pdfIncludeSchedule3A">
      <Name>PDF should include Schedule 3-A</Name>
      <Description>2026 draft Schedule 3-A, form page 1 (PDF p. 2): "Complete Schedule 3-A (Form 1040) only if
        you are
        claiming the earned income credit (EIC), additional child tax credit (ACTC), refundable American
        opportunity
        credit, or refundable adoption credit." 2026 draft Form 1040, form page 2 (PDF p. 3), lines
        27a, 28, 29 and 30:
        attach Schedule 3-A when any of those lines has an amount. 26 U.S.C. 32 (EIC),
        24(d) (additional child tax
        credit), 25A(i) (refundable American opportunity credit) and 23 (adoption
        credit). Line 30 is not computed. A
        credit counts only when it is complete and greater than $0, so a
        return without these credits is complete and
        false. Draft form:
        https://www.irs.gov/pub/irs-dft/f1040s3a--dft.pdf (Created 6/24/26), SHA-256
        787e1ae1eaa3e23a184074d0f437f6b2a8fe3f01290f366201f14eeecc82b8db.</Description>
      <Derived>
        <Any>
          <Switch>
            <Case>
              <When>
                <IsComplete>
                  <Dependency module="eitc" path="/earnedIncomeCredit" />
                </IsComplete>
              </When>
              <Then>
                <GreaterThan>
                  <Left>
                    <Dependency module="eitc" path="/earnedIncomeCredit" />
                  </Left>
                  <Right>
                    <Dollar>0</Dollar>
                  </Right>
                </GreaterThan>
              </Then>
            </Case>
            <Case>
              <When>
                <True />
              </When>
              <Then>
                <False />
              </Then>
            </Case>
          </Switch>
          <Switch>
            <Case>
              <When>
                <IsComplete>
                  <Dependency module="ctcOdc3" path="/additionalCtc" />
                </IsComplete>
              </When>
              <Then>
                <GreaterThan>
                  <Left>
                    <Dependency module="ctcOdc3" path="/additionalCtc" />
                  </Left>
                  <Right>
                    <Dollar>0</Dollar>
                  </Right>
                </GreaterThan>
              </Then>
            </Case>
            <Case>
              <When>
                <True />
              </When>
              <Then>
                <False />
              </Then>
            </Case>
          </Switch>
          <Switch>
            <Case>
              <When>
                <IsComplete>
                  <Dependency module="taxCalculations3" path="/americanOpportunityCredit" />
                </IsComplete>
              </When>
              <Then>
                <GreaterThan>
                  <Left>
                    <Dependency module="taxCalculations3" path="/americanOpportunityCredit" />
                  </Left>
                  <Right>
                    <Dollar>0</Dollar>
                  </Right>
                </GreaterThan>
              </Then>
            </Case>
            <Case>
              <When>
                <True />
              </When>
              <Then>
                <False />
              </Then>
            </Case>
          </Switch>
        </Any>
      </Derived>
    </Fact>

    <Fact path="/schedule3ALine2">
      <Name>Schedule 3-A line 2</Name>
      <Description>2026 draft Schedule 3-A, line 2: "Subtract line 1b from line 1a." Line 1a is Form 1040 line 32a
        and
        line 1b is Form 1040 line 31, so line 2 is lines 27a, 28, 29 and 30 (26 U.S.C. 32, 24(d), 25A(i) and 23).
        Line 30
        is not computed and is not in line 32a.</Description>
      <Derived>
        <Round>
          <Subtract>
            <Minuend>
              <Dependency module="taxCalculations3" path="/totalOtherPaymentsRefundableCredits" />
            </Minuend>
            <Subtrahends>
              <Dependency module="schedule3" path="/otherPaymentsAndRefundableCreditsTotal" />
            </Subtrahends>
          </Subtract>
        </Round>
      </Derived>
    </Fact>

