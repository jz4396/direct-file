                    </Right>
                  </GreaterThan>
                </Not>
              </All>
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
          <Case>
            <When>
              <All>
                <IsComplete>
                  <Dependency path="/schedule3ALine2" />
                </IsComplete>
                <IsComplete>
                  <Dependency path="/schedule3ALine5" />
                </IsComplete>
                <GreaterThan>
                  <Left>
                    <Dependency path="/schedule3ALine2" />
                  </Left>
                  <Right>
                    <Dependency path="/schedule3ALine5" />
                  </Right>
                </GreaterThan>
              </All>
            </When>
            <Then>
              <Round>
                <Subtract>
                  <Minuend>
                    <Dependency path="/schedule3ALine2" />
                  </Minuend>
                  <Subtrahends>
                    <Dependency path="/schedule3ALine5" />
                  </Subtrahends>
                </Subtract>
              </Round>
            </Then>
          </Case>
          <Case>
            <When>
              <All>
                <IsComplete>
                  <Dependency path="/schedule3ALine2" />
                </IsComplete>
                <IsComplete>
                  <Dependency path="/schedule3ALine5" />
                </IsComplete>
              </All>
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
