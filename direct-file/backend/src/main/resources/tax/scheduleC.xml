<?xml-model href="./FactDictionaryModule.rng"?>
<!--
  Schedule C (Profit or Loss From Business) + Schedule SE (Self-Employment Tax) — TY2026 (filed in 2027) vertical slice.

  Audit cites (required next to every computation):
  - Gross income: 26 U.S.C. § 61 — https://www.law.cornell.edu/uscode/text/26/61
  - Trade/business expenses: 26 U.S.C. § 162 — https://www.law.cornell.edu/uscode/text/26/162
  - SE tax: 26 U.S.C. § 1401 — https://www.law.cornell.edu/uscode/text/26/1401
  - Net earnings from SE: 26 U.S.C. § 1402 — https://www.law.cornell.edu/uscode/text/26/1402
  - Deductible employer-equivalent portion: 26 U.S.C. § 164(f) — https://www.law.cornell.edu/uscode/text/26/164#f
  - TY2026 OASDI wage base $184,500: SSA, "Cost-of-Living Increase and Other Determinations for 2026", 90 FR 49047 (Nov. 3, 2025),
    at 49047 and 49050: "The OASDI contribution and benefit base is $184,500 for remuneration paid in
    2026 and self-employment income earned in tax years beginning in 2026." —
    https://www.federalregister.gov/d/2025-19763 (PDF: https://www.govinfo.gov/content/pkg/FR-2025-11-03/pdf/2025-19763.pdf)
  - Schedule C / SE instructions hubs: https://www.irs.gov/instructions/i1040sc
    https://www.irs.gov/instructions/i1040sse
  - QBI § 199A: explicitly unsupported in this slice (no silent zero) —
    https://www.law.cornell.edu/uscode/text/26/199A

  Implements gap: docs/tax/GAP-SCHEDULE-C.md (PR #3).
-->
<FactDictionaryModule>
  <Facts>

    <!-- ========== Collection / interview ========== -->

    <Fact path="/scheduleCBusinesses">
      <Name>Schedule C businesses</Name>
      <Description>
        One or more sole-proprietor / gig businesses reported on Schedule C.
        Gross income inclusion authority: 26 U.S.C. § 61.
      </Description>
      <Export downstreamFacts="true" />
      <Writable>
        <Collection />
      </Writable>
    </Fact>

    <Fact path="/scheduleCBusinessesIsDone">
      <Name>Schedule C businesses done</Name>
      <Description>Filer finished the Schedule C business loop.</Description>
      <Export downstreamFacts="true" />
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/hasScheduleCBusinesses">
      <Name>Has Schedule C businesses</Name>
      <Description>Whether any Schedule C businesses are listed.</Description>
      <Export downstreamFacts="true" />
      <Derived>
        <GreaterThan>
          <Left>
            <CollectionSize>
              <Dependency path="/scheduleCBusinesses" />
            </CollectionSize>
          </Left>
          <Right>
            <Int>0</Int>
          </Right>
        </GreaterThan>
      </Derived>
    </Fact>

    <Fact path="/hadSelfEmploymentIncome">
      <Name>Had self-employment / gig / freelance income</Name>
      <Description>
        Interview gate: whether the filer (or spouse) had self-employment, gig, or freelance income
        that belongs on Schedule C. Gap evidence Pub 6048 excluded this from upstream Direct File:
        https://www.irs.gov/pub/irs-pdf/p6048.pdf
      </Description>
      <Export downstreamFacts="true" />
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/wantsQbiDeduction">
      <Name>Wants qualified business income deduction</Name>
      <Description>
        Explicit § 199A gate. This vertical slice does NOT compute QBI.
        If true → knockout (no silent zero). Cite: 26 U.S.C. § 199A —
        https://www.law.cornell.edu/uscode/text/26/199A
      </Description>
      <Export downstreamFacts="true" />
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/flowKnockoutScheduleCQbi">
      <Name>Knockout: QBI § 199A not supported</Name>
      <Description>
        Explicit non-support for § 199A in this slice. Blast radius: AGI/credits if QBI were silently zeroed.
      </Description>
      <BlockSubmissionOnTrue />
      <Export downstreamFacts="true" />
      <Derived>
        <All>
          <Dependency path="/hadSelfEmploymentIncome" />
          <Dependency path="/wantsQbiDeduction" />
        </All>
      </Derived>
    </Fact>

    <Fact path="/scheduleCSecondaryFilerBusinesses">
      <Name>Schedule C businesses owned by the secondary filer</Name>
      <Derived>
        <Filter path="/scheduleCBusinesses">
          <Dependency path="filer/isSecondaryFiler" />
        </Filter>
      </Derived>
    </Fact>

    <Fact path="/scheduleCSecondaryFilerNetProfitOrLoss">
      <Name>Secondary filer's Schedule C net profit or (loss)</Name>
      <Description>
        #118. Sum of /scheduleCBusinesses/*/netProfitOrLoss for the businesses the secondary filer owns: the line 3 of
        that spouse's own Schedule SE. 2026 draft Instructions for Schedule SE, PDF p. 3: "If both spouses have
        self-employment income, each must file a separate Schedule SE." $0 on a return that isn't a joint return
        (only a joint return reports a spouse's business) or when the filer answered no to self-employment income;
        incomplete while businesses are still being entered, like /scheduleCNetProfitOrLoss.
      </Description>
      <Export downstreamFacts="true" />
      <Derived>
        <Switch>
          <Case>
            <When>
              <Not>
                <Dependency module="filingStatus" path="/isFilingStatusMFJ" />
              </Not>
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
          <Case>
            <When>
              <IsComplete>
                <Dependency path="/scheduleCBusinesses" />
              </IsComplete>
            </When>
            <Then>
              <Round>
                <CollectionSum>
                  <Dependency path="/scheduleCSecondaryFilerBusinesses/*/netProfitOrLoss" />
                </CollectionSum>
              </Round>
            </Then>
          </Case>
          <Case>
            <When>
              <Not>
                <IsComplete>
                  <Dependency path="/hadSelfEmploymentIncome" />
                </IsComplete>
              </Not>
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
          <Case>
            <When>
              <Dependency path="/hadSelfEmploymentIncome" />
            </When>
            <Then>
              <Round>
                <CollectionSum>
                  <Dependency path="/scheduleCSecondaryFilerBusinesses/*/netProfitOrLoss" />
                </CollectionSum>
              </Round>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/scheduleCPrimaryFilerNetProfitOrLoss">
      <Name>Primary filer's Schedule C net profit or (loss)</Name>
      <Description>
        #118. Every business not owned by the secondary filer is the primary filer's (/scheduleCBusinesses/*/filer
        defaults to the primary filer), so this is /scheduleCNetProfitOrLoss minus
        /scheduleCSecondaryFilerNetProfitOrLoss, and the two always add up to Schedule 1 line 3.
      </Description>
      <Export downstreamFacts="true" />
      <Derived>
        <Subtract>
          <Minuend>
            <Dependency path="/scheduleCNetProfitOrLoss" />
          </Minuend>
          <Subtrahends>
            <Dependency path="/scheduleCSecondaryFilerNetProfitOrLoss" />
          </Subtrahends>
        </Subtract>
      </Derived>
    </Fact>

    <Fact path="/flowKnockoutScheduleCSpouseBusiness">
      <Name>Knockout: spouse-owned Schedule C business</Name>
      <Description>
        Schedule SE is figured per filer (scheduleSE /secondaryFilerSelfEmploymentTax, with that spouse's own
        OASDI base under 26 U.S.C. 1402(b)(1)) and Schedule 2 line 4, Schedule 1 line 15 and Form 8959 line 13
        combine both. A secondary filer's business still stops the return until the rest of that spouse's path is
        per spouse: EITC and CDCC earned income with self-employment (Form 2441 lines 4 and 5 are per spouse), and
        the printed return has no Schedule SE form yet (one per spouse once it does).
      </Description>
      <BlockSubmissionOnTrue />
      <Export downstreamFacts="true" />
      <Derived>
        <GreaterThan>
          <Left>
            <CollectionSize>
              <Dependency path="/scheduleCSecondaryFilerBusinesses" />
            </CollectionSize>
          </Left>
          <Right>
            <Int>0</Int>
          </Right>
        </GreaterThan>
      </Derived>
    </Fact>

    <Fact path="/flowKnockoutScheduleCEarnedIncomeCredits">
      <Name>Knockout: Schedule C income with EITC / CDCC (or ACTC with a loss)</Name>
      <Description>
        Explicit non-support (no silent mis-statement) in this slice:
        - EITC earned income (26 U.S.C. 32(c)(2)(A)(ii)) and CDCC earned income (26 U.S.C. 21(d)(2),
          32(c)(2)) include net earnings from self-employment, but the eitc*/cdcc modules still use
          wages only (/employerIncomeSubtotal). Any nonzero Schedule C result with EITC or CDCC
          eligibility is knocked out until those modules are wired.
        - ACTC earned income (Schedule 8812 line 18a) is wired via /scheduleCNetProfitForEarnedIncome,
          which floors a net loss at zero; a Schedule C loss with CTC eligibility is knocked out.
      </Description>
      <BlockSubmissionOnTrue />
      <Export downstreamFacts="true" />
      <Derived>
        <Any>
          <All>
            <Not>
              <Equal>
                <Left>
                  <Dependency path="/scheduleCNetProfitOrLoss" />
                </Left>
                <Right>
                  <Dollar>0</Dollar>
                </Right>
              </Equal>
            </Not>
            <Any>
              <Dependency module="eitc" path="/eitcQualified" />
              <Dependency module="cdcc" path="/cdccQualified" />
            </Any>
          </All>
          <All>
            <LessThan>
              <Left>
                <Dependency path="/scheduleCNetProfitOrLoss" />
              </Left>
              <Right>
                <Dollar>0</Dollar>
              </Right>
            </LessThan>
            <Dependency module="ctcOdc" path="/ctcQualified" />
          </All>
        </Any>
      </Derived>
    </Fact>


    <!-- ========== Per-business facts ========== -->

    <Fact path="/scheduleCBusinesses/*/filer">
      <Name>Business owner (filer)</Name>
      <Description>Which filer owns this Schedule C business.</Description>
      <Writable>
        <CollectionItem collection="/filers" />
      </Writable>
      <Placeholder>
        <Dependency module="filers" path="/primaryFiler" />
      </Placeholder>
    </Fact>

    <Fact path="/scheduleCBusinesses/*/businessName">
      <Name>Business name</Name>
      <Description>Schedule C identifying information — principal business / professional activity name.</Description>
      <Writable>
        <String />
        <Limit type="Match">
          <String><![CDATA[[\sA-Za-z0-9\-.,&']+]]></String>
        </Limit>
      </Writable>
    </Fact>

    <Fact path="/scheduleCBusinesses/*/writableGrossReceipts">
      <Name>Gross receipts or sales</Name>
      <Description>
        Schedule C Part I gross receipts (cash MVP). Inclusion: 26 U.S.C. § 61.
        Cite Schedule C instructions PDF page for the line rule used in the implementation PR notes.
      </Description>
      <Writable>
        <Dollar />
      </Writable>
    </Fact>

    <Fact path="/scheduleCBusinesses/*/grossReceipts">
      <Name>Gross receipts or sales (derived)</Name>
      <Description>Gross receipts defaulting incomplete writable to zero for sums.</Description>
      <Derived>
        <Switch>
          <Case>
            <When>
              <IsComplete>
                <Dependency path="../writableGrossReceipts" />
              </IsComplete>
            </When>
            <Then>
              <Dependency path="../writableGrossReceipts" />
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/scheduleCBusinesses/*/writableTotalExpenses">
      <Name>Total business expenses (MVP)</Name>
      <Description>
        MVP expense bucket (sum of deductible trade/business expenses). Authority: 26 U.S.C. § 162
        (ordinary and necessary expenses paid or incurred in carrying on a trade or business) —
        https://www.law.cornell.edu/uscode/text/26/162
        Category-level Schedule C Part II lines can replace this bucket in a later PR.
      </Description>
      <Writable>
        <Dollar />
      </Writable>
    </Fact>

    <Fact path="/scheduleCBusinesses/*/totalExpenses">
      <Name>Total business expenses (derived)</Name>
      <Description>Expenses defaulting incomplete writable to zero for sums.</Description>
      <Derived>
        <Switch>
          <Case>
            <When>
              <IsComplete>
                <Dependency path="../writableTotalExpenses" />
              </IsComplete>
            </When>
            <Then>
              <Dependency path="../writableTotalExpenses" />
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/scheduleCBusinesses/*/netProfitOrLoss">
      <Name>Net profit or (loss)</Name>
      <Description>
        Schedule C net profit (loss) = gross receipts − expenses.
        Flows to Schedule 1, line 3 (business income or loss).
        Gross: § 61; expenses: § 162.
      </Description>
      <Export mef="true" />
      <Derived>
        <Round>
          <Subtract>
            <Minuend>
              <Dependency path="../grossReceipts" />
            </Minuend>
            <Subtrahends>
              <Dependency path="../totalExpenses" />
            </Subtrahends>
          </Subtract>
        </Round>
      </Derived>
    </Fact>

    <Fact path="/scheduleCBusinesses/*/isComplete">
      <Name>Schedule C business complete</Name>
      <Description>Minimum fields for MVP: name, gross receipts, expenses.</Description>
      <Derived>
        <All>
          <IsComplete>
            <Dependency path="../businessName" />
          </IsComplete>
          <IsComplete>
            <Dependency path="../writableGrossReceipts" />
          </IsComplete>
          <IsComplete>
            <Dependency path="../writableTotalExpenses" />
          </IsComplete>
        </All>
      </Derived>
    </Fact>

    <!-- ========== Aggregates → Schedule 1 ========== -->

    <Fact path="/scheduleCNetProfitOrLoss">
      <Name>Total Schedule C net profit or (loss)</Name>
      <Description>
        Sum of Schedule C net profit/(loss) for Schedule 1 line 3 → Form 1040 line 8 (via Schedule 1 line 10).
        Cite: Schedule C instructions; Form 1040 Schedule 1 line 3.
      </Description>
      <Export downstreamFacts="true" mef="true" />
      <ExportZero />
      <!--
        Unset collection handling: a filer who answered "no" (or never reached this section) has no
        /scheduleCBusinesses collection, which would otherwise leave /totalIncome incomplete. If the
        filer answered "yes" but the collection is still unset, the result stays incomplete so
        /totalTaxIsIncomplete blocks submission (no silent zero).
      -->
      <Derived>
        <Switch>
          <Case>
            <When>
              <IsComplete>
                <Dependency path="/scheduleCBusinesses" />
              </IsComplete>
            </When>
            <Then>
              <Round>
                <CollectionSum>
                  <Dependency path="/scheduleCBusinesses/*/netProfitOrLoss" />
                </CollectionSum>
              </Round>
            </Then>
          </Case>
          <Case>
            <When>
              <Not>
                <IsComplete>
                  <Dependency path="/hadSelfEmploymentIncome" />
                </IsComplete>
              </Not>
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
          <Case>
            <When>
              <Dependency path="/hadSelfEmploymentIncome" />
            </When>
            <Then>
              <Round>
                <CollectionSum>
                  <Dependency path="/scheduleCBusinesses/*/netProfitOrLoss" />
                </CollectionSum>
              </Round>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/scheduleCNetProfitForEarnedIncome">
      <Name>Schedule C net profit included in earned income</Name>
      <Description>
        Earned income from self-employment for EITC/ACTC = Schedule C net profit minus the deductible
        part of SE tax (Schedule 1 line 15), per Pub. 596 EIC Worksheet B (26 U.S.C. 32(c)(2)(A)(ii)).
        Floored at zero for this component in this MVP (net SE loss not netted against wages).
      </Description>
      <Export downstreamFacts="true" />
      <Derived>
        <GreaterOf>
          <Subtract>
            <Minuend>
              <Dependency path="/scheduleCNetProfitOrLoss" />
            </Minuend>
            <Subtrahends>
              <Dependency module="scheduleSE" path="/deductibleSelfEmploymentTax" />
            </Subtrahends>
          </Subtract>
          <Dollar>0</Dollar>
        </GreaterOf>
      </Derived>
    </Fact>


  </Facts>
</FactDictionaryModule>
