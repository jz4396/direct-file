    <Fact path="/form8949Transactions/*/isShortTermBox">
      <Name>Box is a Part I (short-term) box</Name>
      <Description>Boxes A/B/C/G/H/I are Part I (short-term); D/E/F/J/K/L are Part II (long-term).
        Form 8949 instr. (2025) pp.3–4.</Description>
      <Derived>
        <Any>
          <Dependency path="../isBoxA" />
          <Dependency path="../isBoxB" />
          <Dependency path="../isBoxC" />
        </Any>
      </Derived>
    </Fact>

    <Fact path="/form8949Transactions/*/hasBoxHoldingPeriodMismatch">
      <Name>Box does not match holding period</Name>
      <Description>IRC §1222: short-term (held 1 year or less) goes in Part I, long-term in Part II.
        A Part II box with a short-term holding period (or vice versa) would put the gain on the wrong
        Schedule D line, so it blocks submission.</Description>
      <Derived>
        <Not>
          <Equal>
            <Left>
              <Dependency path="../isShortTermBox" />
            </Left>
            <Right>
              <Dependency path="../isShortTerm" />
            </Right>
          </Equal>
        </Not>
      </Derived>
    </Fact>

