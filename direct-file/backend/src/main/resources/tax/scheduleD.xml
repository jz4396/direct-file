    <!-- Prior-year capital loss carryover (Schedule D lines 6 and 14). Entered as positive amounts
         from the prior-year Capital Loss Carryover Worksheet (Schedule D instructions, lines 6 and 14).
         IRC §1212(b)(1): the excess loss carries forward, keeping its short-/long-term character. -->
    <Fact path="/writableShortTermCapitalLossCarryover">
      <Name>Short-term capital loss carryover (writable)</Name>
      <Description>Schedule D line 6 — short-term capital loss carryover from the prior year. IRC §1212(b)(1)(A).</Description>
      <Writable>
        <Dollar />
        <Limit type="Min">
          <Dollar>0</Dollar>
        </Limit>
      </Writable>
    </Fact>

    <Fact path="/shortTermCapitalLossCarryover">
      <Name>Short-term capital loss carryover</Name>
