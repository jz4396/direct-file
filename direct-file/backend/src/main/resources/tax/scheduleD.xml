    <Fact path="/form8949Transactions/*/writableAdjustment">
      <Name>Amount of adjustment</Name>
      <Description>Form 8949 column (g) — Amount of adjustment (Form 8949 instr. (2025) p.8). Optional.</Description>
      <Writable>
        <Dollar />
      </Writable>
    </Fact>

    <Fact path="/form8949Transactions/*/adjustment">
      <Name>Amount of adjustment (default 0)</Name>
      <Description>Form 8949 column (g); defaults to $0 when blank.</Description>
      <Derived>
        <Switch>
          <Case>
            <When>
              <IsComplete>
                <Dependency path="../writableAdjustment" />
              </IsComplete>
            </When>
            <Then>
              <Dependency path="../writableAdjustment" />
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/form8949Transactions/*/adjustmentCode">
      <Name>Code(s) from instructions for columns (f) and (g)</Name>
      <Description>Form 8949 column (f) — optional adjustment code (Form 8949 instr. (2025) p.7).</Description>
      <Writable>
        <String />
        <Limit type="MaxLength">
          <Int>7</Int>
        </Limit>
      </Writable>
    </Fact>

    <Fact path="/form8949Transactions/*/box">
      <Name>Form 8949 checkbox</Name>
      <Description>Which Form 8949 box applies (A–L). Instructions pp.3–4.</Description>
      <Writable>
        <Enum optionsPath="/form8949BoxOptions" />
      </Writable>
    </Fact>

    <Fact path="/form8949Transactions/*/holdingPeriod">
      <Name>Holding period</Name>
      <Description>shortTerm → Form 8949 Part I / Schedule D Part I;
        longTerm → Form 8949 Part II / Schedule D Part II. IRC §1222.</Description>
      <Writable>
        <Enum optionsPath="/form8949HoldingPeriodOptions" />
      </Writable>
    </Fact>

    <Fact path="/form8949Transactions/*/hasSeenLastAvailableScreen">
      <Name>Has seen last available screen</Name>
      <Description>Flow completeness marker for this Form 8949 transaction.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/form8949Transactions/*/gainOrLoss">
      <Name>Gain or loss</Name>
      <Description>Form 8949 column (h): column (d) − column (e) ± column (g)
        (Form 8949 instr. (2025) p.11, "Column (h)—Gain (or Loss)" Examples 1–3).</Description>
      <Derived>
        <Round>
          <Add>
            <Subtract>
              <Minuend>
                <Dependency path="../proceeds" />
              </Minuend>
              <Subtrahends>
                <Dependency path="../costBasis" />
              </Subtrahends>
            </Subtract>
            <Dependency path="../adjustment" />
          </Add>
        </Round>
      </Derived>
    </Fact>

    <Fact path="/form8949Transactions/*/isShortTerm">
      <Name>Is short-term transaction</Name>
      <Derived>
        <Equal>
          <Left>
            <Dependency path="../holdingPeriod" />
          </Left>
          <Right>
            <Enum optionsPath="/form8949HoldingPeriodOptions">shortTerm</Enum>
          </Right>
        </Equal>
      </Derived>
    </Fact>

    <Fact path="/form8949Transactions/*/isLongTerm">
      <Name>Is long-term transaction</Name>
      <Derived>
        <Equal>
          <Left>
            <Dependency path="../holdingPeriod" />
          </Left>
          <Right>
            <Enum optionsPath="/form8949HoldingPeriodOptions">longTerm</Enum>
          </Right>
        </Equal>
      </Derived>
    </Fact>

    <Fact path="/form8949Transactions/*/shortTermGainOrLoss">
      <Name>Short-term gain or loss contribution</Name>
      <Description>gainOrLoss if short-term, else $0 — for Schedule D Part I CollectionSum.</Description>
      <Derived>
        <Switch>
          <Case>
            <When>
              <Dependency path="../isShortTerm" />
            </When>
            <Then>
              <Dependency path="../gainOrLoss" />
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/form8949Transactions/*/longTermGainOrLoss">
