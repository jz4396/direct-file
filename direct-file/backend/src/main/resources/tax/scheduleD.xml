<?xml-model href="./FactDictionaryModule.rng"?>
<FactDictionaryModule>
  <Facts>


    <!--
      Schedule D + Form 8949 — TY2026 capital gains/losses (Phase A: print/local).
      Cites:
      - Rev. Proc. 2025-32 §4.03 p.13 (breakpoints; reused from constants4.xml merged in PR #2 — no duplicate amounts)
      - IRC §1211(b) ($3,000 / $1,500 MFS loss limit)
      - IRC §1(h), §1221, §1222
      - Form 8949 instructions (2025) pp.3–4 (boxes A–F / G–L)
      - Schedule D instructions (2025) p.3 ($3,000 against ordinary income); p.10 (lines 6/14 carryover worksheet); p.14 (line 21)
      - Schedule D (2025) lines 1b/2/3/8b/9/10: "Totals for all transactions reported on Form(s) 8949
        with Box A or Box G checked" (likewise B/H, C/I, D/J, E/K, F/L)
      QDCG Tax Worksheet (Form 1040 line 16) lives in scheduleD3.xml.
      Out of scope this PR: MeF e-file, wash sales, 28% collectibles / unrecaptured §1250 (Schedule D
      Tax Worksheet), next-year carryover worksheet, Form 8949 PDF.
    -->

    <Fact path="/form8949BoxOptions">
      <Name>Form 8949 box options</Name>
      <Description>Form 8949 Part I boxes A–C / G–I and Part II boxes D–F / J–L.
        Instructions for Form 8949 (2025) pp.3–4: Box A/G basis reported to IRS; B/H basis not
        reported; C/I no 1099-B/DA (C/F exclude digital — use I/L). Digital G–L added 2025.</Description>
      <Derived>
        <EnumOptions>
          <String>A</String>
          <String>B</String>
          <String>C</String>
          <String>D</String>
          <String>E</String>
          <String>F</String>
          <String>G</String>
          <String>H</String>
          <String>I</String>
          <String>J</String>
          <String>K</String>
          <String>L</String>
        </EnumOptions>
      </Derived>
    </Fact>

    <Fact path="/form8949HoldingPeriodOptions">
      <Name>Holding period options</Name>
      <Description>IRC §1222 — short-term (held ≤1 year) vs long-term (held &gt;1 year).
        Form 8949 Part I = short-term; Part II = long-term (Form 8949 instr. (2025) p.3).</Description>
      <Derived>
        <EnumOptions>
          <String>shortTerm</String>
          <String>longTerm</String>
        </EnumOptions>
      </Derived>
    </Fact>

    <Fact path="/capitalLossLimit">
      <Export downstreamFacts="true" />
      <Name>Capital loss limit against ordinary income</Name>
      <Description>IRC §1211(b): losses allowed only to the extent of gains plus the lower of
        (1) $3,000 ($1,500 if MFS), or (2) excess of losses over gains.
        Schedule D instr. (2025) p.3: "You can deduct capital losses up to the amount of your
        capital gains plus $3,000 ($1,500 if married filing separately)."</Description>
      <TaxYear>2026</TaxYear>
      <Derived>
        <Switch>
          <Case>
            <When>
              <Dependency module="filingStatus" path="/isFilingStatusMFS" />
            </When>
            <Then>
              <!-- IRC §1211(b)(1): "$3,000 ($1,500 in the case of a married individual filing a separate return)"
                   https://www.law.cornell.edu/uscode/text/26/1211 ; Schedule D instr. (2025) p.3 -->
              <Dollar>1500</Dollar>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <!-- IRC §1211(b)(1) $3,000 limit https://www.law.cornell.edu/uscode/text/26/1211 ;
                   Schedule D instr. (2025) p.3 -->
              <Dollar>3000</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/capitalLossLimitAsNegative">
      <Export downstreamFacts="true" />
      <Name>Capital loss limit as negative dollar</Name>
      <Description>Negated §1211(b) limit for GreaterOf clamp on Form 1040 line 7.</Description>
      <Derived>
        <Subtract>
          <Minuend>
            <Dollar>0</Dollar>
          </Minuend>
          <Subtrahends>
            <Dependency path="/capitalLossLimit" />
          </Subtrahends>
        </Subtract>
      </Derived>
    </Fact>

    <Fact path="/capGainsZeroRateAmount">
      <Export downstreamFacts="true" />
      <Name>Selected max zero rate amount (preferential CG)</Name>
      <Description>Rev. Proc. 2025-32 §4.03 p.13 — filing-status-selected maximum zero rate amount
        under §1(j)(5)(B). Selects the PR #2 constants4.xml facts (no duplicated dollar amounts).</Description>
      <TaxYear>2026</TaxYear>
      <Derived>
        <Switch>
          <Case>
            <When>
              <Any>
                <Dependency module="filingStatus" path="/isFilingStatusMFJ" />
                <Dependency module="filingStatus" path="/isFilingStatusQSS" />
              </Any>
            </When>
            <Then>
              <!-- Rev. Proc. 2025-32 §4.03 p.13 — MFJ / Surviving Spouse maximum zero rate $98,900 -->
              <Dependency module="constants" path="/capGainsZeroRateMFJ" />
            </Then>
          </Case>
          <Case>
            <When>
              <Dependency module="filingStatus" path="/isFilingStatusMFS" />
            </When>
            <Then>
              <!-- Rev. Proc. 2025-32 §4.03 p.13 — MFS maximum zero rate $49,450 -->
              <Dependency module="constants" path="/capGainsZeroRateMFS" />
            </Then>
          </Case>
          <Case>
            <When>
              <Dependency module="filingStatus" path="/isFilingStatusHOH" />
            </When>
            <Then>
              <!-- Rev. Proc. 2025-32 §4.03 p.13 — HoH maximum zero rate $66,200 -->
              <Dependency module="constants" path="/capGainsZeroRateHoH" />
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <!-- Rev. Proc. 2025-32 §4.03 p.13 — All Other Individuals maximum zero rate $49,450 -->
              <Dependency module="constants" path="/capGainsZeroRateSingle" />
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/capGains15RateAmount">
      <Export downstreamFacts="true" />
      <Name>Selected max 15% rate amount (preferential CG)</Name>
      <Description>Rev. Proc. 2025-32 §4.03 p.13 — filing-status-selected maximum 15% rate amount.
        Above this breakpoint, 20% rate applies under §1(h)(1)(D). Selects the PR #2 constants4.xml facts.</Description>
      <TaxYear>2026</TaxYear>
      <Derived>
        <Switch>
          <Case>
            <When>
              <Any>
                <Dependency module="filingStatus" path="/isFilingStatusMFJ" />
                <Dependency module="filingStatus" path="/isFilingStatusQSS" />
              </Any>
            </When>
            <Then>
              <!-- Rev. Proc. 2025-32 §4.03 p.13 — MFJ / Surviving Spouse maximum 15% rate $613,700 -->
              <Dependency module="constants" path="/capGains15RateMFJ" />
            </Then>
          </Case>
          <Case>
            <When>
              <Dependency module="filingStatus" path="/isFilingStatusMFS" />
            </When>
            <Then>
              <!-- Rev. Proc. 2025-32 §4.03 p.13 — MFS maximum 15% rate $306,850 -->
              <Dependency module="constants" path="/capGains15RateMFS" />
            </Then>
          </Case>
          <Case>
            <When>
              <Dependency module="filingStatus" path="/isFilingStatusHOH" />
            </When>
            <Then>
              <!-- Rev. Proc. 2025-32 §4.03 p.13 — HoH maximum 15% rate $579,600 -->
              <Dependency module="constants" path="/capGains15RateHoH" />
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <!-- Rev. Proc. 2025-32 §4.03 p.13 — All Other Individuals maximum 15% rate $545,500 -->
              <Dependency module="constants" path="/capGains15RateSingle" />
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/soldCapitalAssets">
      <Export downstreamFacts="true" />
      <Name>Sold stock or other capital assets</Name>
      <Description>Screener (#28): in the tax year, did the filer sell or exchange stock, bonds, digital assets (crypto), or other capital
        assets, or receive a Form 1099-B or Form 1099-DA? Schedule D instr. (2025) p. D-1: "Use Schedule D: To figure the overall gain
        or loss from transactions reported on Form 8949". Unset is not treated as no.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/flowKnockoutCapitalAssets">
      <Export downstreamFacts="true" />
      <Name>Flow knockout: capital asset sales</Name>
      <Description>The interview has no Form 8949 entry screens yet, so a yes to /soldCapitalAssets knocks out.</Description>
      <BlockSubmissionOnTrue />
      <Derived>
        <Dependency path="/soldCapitalAssets" />
      </Derived>
    </Fact>

    <Fact path="/soldCollectibles">
      <Export downstreamFacts="true" />
      <Name>Sold collectibles</Name>
      <Description>#21: collectibles (28%) gain, e.g. Form 1099-DIV box 2d or a Schedule K-1, taxed up to 28%. IRC §1(h)(4)-(5); Schedule D instr. (2025) p. D-11, Line 18 (28% Rate Gain Worksheet).</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/hasUnrecapturedSection1250Gain">
      <Export downstreamFacts="true" />
      <Name>Has unrecaptured section 1250 gain</Name>
      <Description>#21: unrecaptured §1250 gain, e.g. Form 1099-DIV box 2b or a Schedule K-1, taxed up to 25%. IRC §1(h)(1)(E), §1(h)(6); Schedule D instr. (2025) p. D-11, Line 19.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/flowKnockoutCollectibles">
      <Export downstreamFacts="true" />
      <Name>Flow knockout: collectibles</Name>
      <Description>#21: yes to /soldCollectibles. Phase A: the Schedule D Tax Worksheet is not implemented, so a yes blocks submission instead of silently using the 0/15/20% QDCG worksheet.</Description>
      <BlockSubmissionOnTrue />
      <Derived>
        <All>
          <IsComplete>
            <Dependency path="/soldCollectibles" />
          </IsComplete>
          <Dependency path="/soldCollectibles" />
        </All>
      </Derived>
    </Fact>

    <Fact path="/flowKnockoutUnrecaptured1250Gain">
      <Export downstreamFacts="true" />
      <Name>Flow knockout: unrecaptured section 1250 gain</Name>
      <Description>#21: yes to /hasUnrecapturedSection1250Gain. Phase A: the Schedule D Tax Worksheet is not implemented, so a yes blocks submission instead of silently using the 0/15/20% QDCG worksheet.</Description>
      <BlockSubmissionOnTrue />
      <Derived>
        <All>
          <IsComplete>
            <Dependency path="/hasUnrecapturedSection1250Gain" />
          </IsComplete>
          <Dependency path="/hasUnrecapturedSection1250Gain" />
        </All>
      </Derived>
    </Fact>

    <Fact path="/form8949Transactions">
      <Export downstreamFacts="true" />
      <Name>Form 8949 transactions</Name>
      <Description>Manual capital asset dispositions reported on Form 8949 then totaled on Schedule D.
        Form 8949 instr. (2025) pp.1–3: report sales/exchanges of capital assets.</Description>
      <Writable>
        <Collection />
      </Writable>
    </Fact>

    <Fact path="/form8949TransactionsIsDone">
      <Name>Form 8949 transactions entry done</Name>
      <Description>Taxpayer indicated they finished entering Form 8949 transactions.</Description>
      <Export downstreamFacts="true" />
      <Writable>
        <Boolean />
      </Writable>
      <Placeholder>
        <False />
      </Placeholder>
    </Fact>

    <Fact path="/hasForm8949Transactions">
      <Export downstreamFacts="true" />
      <Name>Has Form 8949 transactions</Name>
      <Description>Whether any Form 8949 transactions were entered.</Description>
      <Derived>
        <Switch>
          <Case>
            <When>
              <IsComplete>
                <Dependency path="/form8949Transactions" />
              </IsComplete>
            </When>
            <Then>
              <GreaterThan>
                <Left>
                  <CollectionSize>
                    <Dependency path="/form8949Transactions" />
                  </CollectionSize>
                </Left>
                <Right>
                  <Int>0</Int>
                </Right>
              </GreaterThan>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <False />
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/requiresScheduleD">
      <Name>Requires Schedule D</Name>
      <Description>Schedule D is required when there is Form 8949 activity (Schedule D instr. (2025) p.11:
        complete Form 8949 before Schedule D lines 1b/2/3/8b/9/10) or a prior-year capital loss
        carryover (Schedule D lines 6/14).</Description>
      <Export downstreamFacts="true" mef="true" />
      <Derived>
        <Any>
          <Dependency path="/hasForm8949Transactions" />
          <Dependency path="/hasCapitalLossCarryover" />
        </Any>
      </Derived>
    </Fact>

    <Fact path="/form8949Transactions/*/description">
      <Name>Description of property</Name>
      <Description>Form 8949 column (a) — Description of property (Form 8949 instr. (2025) p.6).</Description>
      <Writable>
        <String />
        <Limit type="MaxLength">
          <Int>100</Int>
        </Limit>
      </Writable>
    </Fact>

    <Fact path="/form8949Transactions/*/dateAcquired">
      <Name>Date acquired</Name>
      <Description>Form 8949 column (b) — Date acquired (Form 8949 instr. (2025) p.6).</Description>
      <Writable>
        <Day />
      </Writable>
    </Fact>

    <Fact path="/form8949Transactions/*/dateSold">
      <Name>Date sold or disposed of</Name>
      <Description>Form 8949 column (c) — Date sold or disposed of (Form 8949 instr. (2025) p.6).</Description>
      <Writable>
        <Day />
      </Writable>
    </Fact>

    <Fact path="/form8949Transactions/*/proceeds">
      <Name>Proceeds (sales price)</Name>
