    <Fact path="/scheduleDLine14">
      <Name>Schedule D line 14 — long-term capital loss carryover</Name>
      <Description>Prior-year long-term capital loss carryover (Capital Loss Carryover Worksheet,
        Schedule D instr. (2025) p.10). Shown in parentheses on the form; IRC §1212(b)(1)(B).</Description>
      <Export mef="true" />
      <ExportZero />
      <Derived>
        <Dependency module="scheduleD" path="/longTermCapitalLossCarryover" />
      </Derived>
    </Fact>

    <Fact path="/scheduleDLine15">
      <Name>Schedule D line 15 — net long-term capital gain or loss</Name>
      <Description>Schedule D Part II line 15: combine lines 8a through 14 (lines 8a/11/12/13 = $0 in scope;
        line 14 long-term carryover is subtracted). Schedule D instr. (2025) p.10 (lines 6/14).</Description>
      <Export downstreamFacts="true" mef="true" />
      <ExportZero />
      <Derived>
        <Round>
          <Subtract>
            <Minuend>
              <Add>
                <Dependency path="/scheduleDLine8b" />
                <Dependency path="/scheduleDLine9" />
                <Dependency path="/scheduleDLine10" />
              </Add>
            </Minuend>
            <Subtrahends>
              <Dependency path="/scheduleDLine14" />
            </Subtrahends>
          </Subtract>
        </Round>
      </Derived>
    </Fact>

    <!-- Schedule D Part III -->
    <Fact path="/scheduleDLine16">
      <Name>Schedule D line 16 — combine lines 7 and 15</Name>
      <Description>Net capital gain or loss before §1211(b) limitation.</Description>
      <Export downstreamFacts="true" mef="true" />
      <ExportZero />
      <Derived>
        <Round>
          <Add>
            <Dependency path="/scheduleDLine7" />
            <Dependency path="/scheduleDLine15" />
          </Add>
        </Round>
      </Derived>
    </Fact>

    <Fact path="/scheduleDLine21">
      <Name>Schedule D line 21 — capital loss limitation</Name>
      <Description>If line 16 is a loss, the deductible amount against ordinary income is the lesser of
        the loss or the §1211(b) limit ($3,000 / $1,500 MFS). Schedule D instr. (2025) p.14 (Line 21);
        IRC §1211(b). Shown as a positive amount on the form.</Description>
      <Export downstreamFacts="true" mef="true" />
      <ExportZero />
      <Derived>
        <Round>
          <Switch>
            <Case>
              <When>
                <LessThan>
                  <Left>
                    <Dependency path="/scheduleDLine16" />
                  </Left>
                  <Right>
                    <Dollar>0</Dollar>
                  </Right>
                </LessThan>
              </When>
              <Then>
                <LesserOf>
                  <Dependency module="scheduleD" path="/capitalLossLimit" />
                  <Subtract>
                    <Minuend>
                      <Dollar>0</Dollar>
                    </Minuend>
                    <Subtrahends>
                      <Dependency path="/scheduleDLine16" />
                    </Subtrahends>
                  </Subtract>
                </LesserOf>
              </Then>
            </Case>
            <Case>
              <When>
                <True />
              </When>
              <Then>
                <Dollar>0</Dollar>
              </Then>
            </Case>
          </Switch>
        </Round>
      </Derived>
    </Fact>

    <Fact path="/capitalGainsOrLossesFor1040">
      <Name>Capital gains or losses for Form 1040 line 7</Name>
      <Description>Form 1040 line 7: net capital gain, or limited net capital loss after §1211(b).
        If Schedule D line 16 ≥ 0 → line 16; if loss → GreaterOf(line 16, −limit).</Description>
      <Export downstreamFacts="true" mef="true" />
      <ExportZero />
      <Derived>
        <Round>
          <Switch>
            <Case>
              <When>
                <Dependency module="scheduleD" path="/requiresScheduleD" />
              </When>
              <Then>
                <GreaterOf>
                  <Dependency path="/scheduleDLine16" />
                  <Dependency module="scheduleD" path="/capitalLossLimitAsNegative" />
                </GreaterOf>
              </Then>
            </Case>
            <Case>
              <When>
                <True />
              </When>
              <Then>
                <Dollar>0</Dollar>
              </Then>
            </Case>
          </Switch>
        </Round>
      </Derived>
    </Fact>

    <Fact path="/hasNetLongTermCapitalGain">
      <Name>Has net long-term capital gain</Name>
      <Description>True when Schedule D line 15 &gt; 0 — preferential §1(h) rates may apply
        (breakpoints Rev. Proc. 2025-32 §4.03 p.13). Feeds the QDCG Tax Worksheet in scheduleD3.xml.</Description>
      <Export downstreamFacts="true" />
      <Derived>
        <GreaterThan>
          <Left>
            <Dependency path="/scheduleDLine15" />
          </Left>
          <Right>
            <Dollar>0</Dollar>
          </Right>
        </GreaterThan>
      </Derived>
    </Fact>

  </Facts>
</FactDictionaryModule>
