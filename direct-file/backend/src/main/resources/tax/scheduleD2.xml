              </Then>
            </Case>
          </Switch>
        </Round>
      </Derived>
    </Fact>

    <Fact path="/scheduleDLine6">
      <Name>Schedule D line 6 — short-term capital loss carryover</Name>
      <Description>Prior-year short-term capital loss carryover (Capital Loss Carryover Worksheet,
        Schedule D instr. (2025) p.10). Shown in parentheses on the form; IRC §1212(b)(1)(A).</Description>
      <Export mef="true" />
      <ExportZero />
      <Derived>
        <Dependency module="scheduleD" path="/shortTermCapitalLossCarryover" />
      </Derived>
    </Fact>

    <Fact path="/scheduleDLine7">
      <Name>Schedule D line 7 — net short-term capital gain or loss</Name>
      <Description>Schedule D Part I line 7: combine lines 1a through 6 (lines 1a/4/5 = $0 in scope;
        line 6 short-term carryover is subtracted). Schedule D instr. (2025) p.10 (lines 6/14).</Description>
      <Export downstreamFacts="true" mef="true" />
      <ExportZero />
      <Derived>
        <Round>
          <Subtract>
            <Minuend>
              <Add>
                <Dependency path="/scheduleDLine1b" />
                <Dependency path="/scheduleDLine2" />
                <Dependency path="/scheduleDLine3" />
              </Add>
            </Minuend>
            <Subtrahends>
              <Dependency path="/scheduleDLine6" />
            </Subtrahends>
          </Subtract>
        </Round>
      </Derived>
    </Fact>

    <!-- Schedule D Part II — long-term (boxes D/E/F → lines 8b/9/10; line 15 net) -->
    <Fact path="/scheduleDLine8b">
