    <!-- Schedule D Part III -->
    <Fact path="/scheduleDLine16">
      <Name>Schedule D line 16 — combine lines 7 and 15</Name>
      <Description>Net capital gain or loss before §1211(b) limitation.</Description>
      <Export downstreamFacts="true" mef="true" />
      <ExportZero />
      <Derived>
        <Round>
          <Add>
            <Dependency path="/scheduleDLine7" />
            <Dependency path="/scheduleDLine15" />
          </Add>
        </Round>
      </Derived>
    </Fact>

    <Fact path="/scheduleDLine21">
      <Name>Schedule D line 21 — capital loss limitation</Name>
      <Description>If line 16 is a loss, the deductible amount against ordinary income is the lesser of
        the loss or the §1211(b) limit ($3,000 / $1,500 MFS). Schedule D instr. (2025) p.14 (Line 21);
        IRC §1211(b). Shown as a positive amount on the form.</Description>
      <Export downstreamFacts="true" mef="true" />
      <ExportZero />
      <Derived>
        <Round>
          <Switch>
            <Case>
              <When>
                <LessThan>
                  <Left>
                    <Dependency path="/scheduleDLine16" />
                  </Left>
                  <Right>
                    <Dollar>0</Dollar>
                  </Right>
                </LessThan>
              </When>
              <Then>
                <LesserOf>
                  <Dependency module="scheduleD" path="/capitalLossLimit" />
                  <Subtract>
                    <Minuend>
                      <Dollar>0</Dollar>
                    </Minuend>
                    <Subtrahends>
                      <Dependency path="/scheduleDLine16" />
                    </Subtrahends>
                  </Subtract>
                </LesserOf>
              </Then>
            </Case>
            <Case>
              <When>
                <True />
              </When>
              <Then>
                <Dollar>0</Dollar>
              </Then>
            </Case>
          </Switch>
        </Round>
      </Derived>
    </Fact>

    <!-- #35 follow-up: Schedule D Part III Yes/No boxes, 2026 draft Schedule D (irs.gov/pub/irs-dft, Created 4/1/26)
      p. 2. Line 16: "If line 16 is a gain, ... go to line 17 below. If line 16 is a loss, skip lines 17 through 20
      below. Then, go to line 21. Also be sure to complete line 22. If line 16 is zero, skip lines 17 through 21 below
      ... Then, go to line 22." Line 17: "Are lines 15 and 16 both gains? Yes. Go to line 18. No. Skip lines 18
      through 21, and go to line 22." Line 20 (Yes): "Don't complete lines 21 and 22 below." -->
    <Fact path="/scheduleDLine17Yes">
      <Name>Schedule D line 17 Yes: lines 15 and 16 are both gains</Name>
      <Description>Checked when line 16 and line 15 are both more than zero, so there is a net capital gain (IRC
        1222(11)) taxed under IRC 1(h).</Description>
      <Derived>
        <All>
          <GreaterThan>
            <Left>
              <Dependency path="/scheduleDLine16" />
            </Left>
            <Right>
              <Dollar>0</Dollar>
            </Right>
          </GreaterThan>
          <GreaterThan>
            <Left>
              <Dependency path="/scheduleDLine15" />
            </Left>
            <Right>
              <Dollar>0</Dollar>
            </Right>
          </GreaterThan>
        </All>
      </Derived>
    </Fact>

    <Fact path="/scheduleDLine17No">
      <Name>Schedule D line 17 No</Name>
      <Description>Checked when line 16 is a gain but line 15 is zero or a loss. Line 17 is skipped (neither box) when
        line 16 is zero or a loss.</Description>
      <Derived>
        <All>
          <GreaterThan>
            <Left>
              <Dependency path="/scheduleDLine16" />
            </Left>
            <Right>
              <Dollar>0</Dollar>
            </Right>
          </GreaterThan>
          <Not>
            <GreaterThan>
              <Left>
                <Dependency path="/scheduleDLine15" />
              </Left>
              <Right>
                <Dollar>0</Dollar>
              </Right>
            </GreaterThan>
          </Not>
        </All>
      </Derived>
    </Fact>

    <Fact path="/scheduleDLine20Yes">
      <Name>Schedule D line 20 Yes: lines 18 and 19 zero or blank, no Form 4952</Name>
      <Description>Checked only when line 17 is Yes and lines 18 and 19 are provably zero: every input this
        tool knows that can put an amount on them is complete and false. Line 18 (28% rate gain, IRC §1(h)(4)):
        collectibles gain (scheduleD /flowKnockoutCollectibles) and section 1202 gain, IRC §1(h)(4)(A)(ii) and
        §1(h)(7) (scheduleD /flowKnockoutForm8949CodeQ, Form 8949 code Q). Line 19 (unrecaptured section 1250
        gain, IRC §1(h)(6)): scheduleD /flowKnockoutUnrecaptured1250Gain. Both: Form 1099-DIV boxes 2b, 2c and
        2d (dividends /flowKnockoutDividendUnsupportedBoxes). Each of those stops the return, so on a supported
        return lines 18 and 19 print blank. Form 4952 is never filed: investment interest (Schedule A line 9,
        IRC 163(d)) stops the return (#37 /flowKnockoutScheduleAUnsupported). The tax is then figured on the
        Qualified Dividends and Capital Gain Tax Worksheet (scheduleD3.xml), matching this box; line 20 No
        (Schedule D Tax Worksheet) is never checked.</Description>
      <Derived>
        <All>
          <Dependency path="/scheduleDLine17Yes" />
          <IsComplete>
            <Dependency module="scheduleD" path="/flowKnockoutCollectibles" />
          </IsComplete>
          <Not>
            <Dependency module="scheduleD" path="/flowKnockoutCollectibles" />
          </Not>
          <IsComplete>
            <Dependency module="scheduleD" path="/flowKnockoutForm8949CodeQ" />
          </IsComplete>
          <Not>
            <Dependency module="scheduleD" path="/flowKnockoutForm8949CodeQ" />
          </Not>
          <IsComplete>
            <Dependency module="scheduleD" path="/flowKnockoutUnrecaptured1250Gain" />
          </IsComplete>
          <Not>
            <Dependency module="scheduleD" path="/flowKnockoutUnrecaptured1250Gain" />
          </Not>
          <IsComplete>
            <Dependency module="dividends" path="/flowKnockoutDividendUnsupportedBoxes" />
          </IsComplete>
          <Not>
            <Dependency module="dividends" path="/flowKnockoutDividendUnsupportedBoxes" />
          </Not>
        </All>
      </Derived>
    </Fact>

    <Fact path="/scheduleDLine22Yes">
      <Name>Schedule D line 22 Yes: qualified dividends on Form 1040 line 3a</Name>
      <Description>Line 22 is answered when line 17 is not Yes (line 16 zero or a loss, or line 17 No). Yes when Form
        1040 line 3a qualified dividends (IRC 1(h)(11)) are more than zero.</Description>
      <Derived>
        <All>
          <Not>
            <Dependency path="/scheduleDLine17Yes" />
          </Not>
          <GreaterThan>
            <Left>
              <Dependency module="income" path="/qualifiedDividends" />
            </Left>
            <Right>
              <Dollar>0</Dollar>
            </Right>
          </GreaterThan>
        </All>
      </Derived>
    </Fact>

    <Fact path="/scheduleDLine22No">
      <Name>Schedule D line 22 No</Name>
      <Description>Line 22 is answered when line 17 is not Yes, and No when Form 1040 line 3a qualified dividends are
        zero.</Description>
      <Derived>
        <All>
          <Not>
            <Dependency path="/scheduleDLine17Yes" />
          </Not>
          <Not>
            <GreaterThan>
