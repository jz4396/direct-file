    <Fact path="/scheduleDLine7">
      <Name>Schedule D line 7 — net short-term capital gain or loss</Name>
      <Description>Schedule D Part I line 7: combine lines 1a through 6 (lines 1a/4/5 = $0 in scope;
        line 6 short-term carryover is subtracted). Schedule D instr. (2025) p.10 (lines 6/14).</Description>
      <Export downstreamFacts="true" mef="true" />
      <ExportZero />
      <Derived>
        <Round>
          <Subtract>
            <Minuend>
              <Add>
                <Dependency path="/scheduleDLine1b" />
                <Dependency path="/scheduleDLine2" />
                <Dependency path="/scheduleDLine3" />
              </Add>
            </Minuend>
            <Subtrahends>
              <Dependency path="/scheduleDLine6" />
            </Subtrahends>
          </Subtract>
        </Round>
      </Derived>
    </Fact>

