<?xml-model href="./FactDictionaryModule.rng"?>
<FactDictionaryModule>
  <Facts>

    <!-- scheduleD2: Schedule D line totals + Form 1040 line 7. Form 8949 collection lives in scheduleD.xml. -->

    <!-- Schedule D Part I — short-term (boxes A/B/C → lines 1b/2/3; line 7 net) -->
    <Fact path="/scheduleDLine1b">
      <Name>Schedule D line 1b</Name>
      <Description>Schedule D (2025): line label "...Form(s) 8949 with Box A or Box G checked" (ST, basis reported). Form 8949 instr. (2025) p.3.</Description>
      <Export mef="true" />
      <ExportZero />
      <Derived>
        <Round>
          <Switch>
            <!-- #22/#28: no 8949 entries count as 0 only when the filer answered no to /soldCapitalAssets -->
            <Case>
              <When>
                <Dependency module="scheduleD" path="/hasForm8949Transactions" />
              </When>
              <Then>
                <CollectionSum>
            <Dependency module="scheduleD" path="/form8949Transactions/*/gainOrLossBoxA" />
          </CollectionSum>
              </Then>
            </Case>
            <Case>
              <When>
                <Not>
                  <Dependency module="scheduleD" path="/soldCapitalAssets" />
                </Not>
              </When>
              <Then>
                <Dollar>0</Dollar>
              </Then>
            </Case>
          </Switch>
        </Round>
      </Derived>
    </Fact>

