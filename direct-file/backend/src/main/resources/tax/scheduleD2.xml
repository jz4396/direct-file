                </Not>
              </When>
              <Then>
                <Dollar>0</Dollar>
              </Then>
            </Case>
          </Switch>
        </Round>
      </Derived>
    </Fact>

    <Fact path="/scheduleDLine3">
      <Name>Schedule D line 3</Name>
      <Description>Schedule D (2025): line label "...Form(s) 8949 with Box C or Box I checked" (ST, no 1099-B). Form 8949 instr. (2025) p.3.</Description>
      <Export mef="true" />
      <ExportZero />
      <Derived>
        <Round>
          <Switch>
            <!-- #22/#28: no 8949 entries count as 0 only when the filer answered no to /soldCapitalAssets -->
            <Case>
              <When>
                <Dependency module="scheduleD" path="/hasForm8949Transactions" />
              </When>
              <Then>
                <CollectionSum>
            <Dependency module="scheduleD" path="/form8949Transactions/*/gainOrLossBoxC" />
          </CollectionSum>
              </Then>
            </Case>
            <Case>
              <When>
