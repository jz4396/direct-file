# Static client-only build: `npm run build:static` (vite build --mode static). See src/staticClient/staticMode.ts.
# No Direct File backend: API calls are answered in the browser (src/staticClient/localApi.ts) and every network
# API is blocked (src/staticClient/networkGuard.ts). The backend URL uses the reserved .invalid domain, which never
# resolves, so nothing could reach a server even if a request escaped the guard and the CSP (connect-src 'none').
VITE_STATIC_CLIENT_ONLY=true
VITE_BACKEND_URL=https://df-static-client.invalid/df/file/api/
VITE_PUBLIC_PATH=/df/file
# Sign-out does a full page load (dropping the in-memory return) after clearing storage. auth/storage.ts treats any
# link whose href contains this value as a sign-out link, so it must not be a prefix of app routes.
VITE_SADI_LOGOUT_URL=/df/file/home?signed-out=1
VITE_ALLOW_LOADING_TEST_DATA=
VITE_ENABLE_ESSAR_SIGNING=
# The in-memory return would be lost on an automatic sign-out redirect, and there is no session to keep alive.
VITE_DISABLE_AUTO_LOGOUT=true
