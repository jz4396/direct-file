or in school. Used for CDCC</Description>

      <Derived>
        <Multiply>
          <Dependency module="filers" path="/secondaryFiler/cdccMonthsDisabledOrInSchool" />
          <Dependency path="/monthlyIncomeIfDisabledOrInSchool" />
